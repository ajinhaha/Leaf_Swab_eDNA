# ==========================================================
# PANEL B: CLASSIFY EACH INPUT OTU EXACTLY ONCE
# ==========================================================
# An OTU is a row in the original marker-specific read table.
# The Note column records reasons for exclusion.
# If multiple reasons occur in one Note, assign the first match
# according to the priority order below. This avoids double counting.
# Retained_OTUs includes rows with no matching exclusion reason.
# The same exclusions are applied later to panels C and D.
# IMPORTANT: These are OTU counts, not read counts or unique taxa.

filter_categories <- c(
  "Control", "No_Borneo_Record", "No_Taxa", "Below_Genus",
  "NUMTs", "Human", "Domestic_Animal"
)

classify_otus <- function(df, marker_name) {
  if (!"Note" %in% names(df)) {
    stop(paste("Missing Note column in", marker_name, "OTU table"))
  }
  notes <- as.character(df$Note)
  category <- rep("Retained_OTUs", nrow(df))
  # First matching exclusion reason takes precedence.
  for (reason in rev(filter_categories)) {
    category[str_detect(coalesce(notes, ""), regex(reason, ignore_case = TRUE))] <- reason
  }
  tibble(Marker = marker_name, OTU_Row = seq_len(nrow(df)),
         Note = notes, Category = category)
}

classified_otus <- bind_rows(
  classify_otus(otu_12S_raw, "12S"),
  classify_otus(otu_16S_raw, "16S")
)

# Include zero-count categories so all categories appear in Excel.
plot_b_df <- classified_otus %>%
  count(Marker, Category, name = "Count") %>%
  complete(Marker = c("12S", "16S"),
           Category = c("Retained_OTUs", filter_categories),
           fill = list(Count = 0)) %>%
  mutate(
    Marker = factor(Marker, levels = c("12S", "16S")),
    Category = factor(Category, levels = c(
      "Domestic_Animal", "Human", "NUMTs", "Below_Genus",
      "No_Taxa", "No_Borneo_Record", "Control", "Retained_OTUs"
    ))
  )

# Verify every input OTU is represented exactly once.
stopifnot(sum(plot_b_df$Count) == nrow(otu_12S_raw) + nrow(otu_16S_raw))

# ==========================================================
# EXPORT PANEL B OTU COUNTS TO A MULTI-SHEET EXCEL WORKBOOK
# ==========================================================
# Sheet 1: counts and percentages for each category by marker.
# Sheet 2: marker-level retained/removed/total OTU summary.
# Sheet 3: original Note and assigned category for each OTU.
# Sheet 4: sequencing read counts and percentages.
# Percentages are calculated within each marker, not across markers.

otu_filter_excel <- plot_b_df %>%
  mutate(Marker = as.character(Marker), Category = as.character(Category)) %>%
  group_by(Marker) %>%
  mutate(Total_OTUs = sum(Count), Percentage = if_else(
    Total_OTUs > 0, 100 * Count / Total_OTUs, NA_real_
  )) %>%
  ungroup() %>%
  select(Marker, Category, Count, Total_OTUs, Percentage) %>%
  arrange(Marker, desc(Category == "Retained_OTUs"), Category)

otu_filter_overview <- classified_otus %>%
  group_by(Marker) %>%
  summarise(
    Total_OTUs = n(),
    Retained_OTUs = sum(Category == "Retained_OTUs"),
    Removed_OTUs = sum(Category != "Retained_OTUs"),
    Retained_Percent = 100 * Retained_OTUs / Total_OTUs,
    Removed_Percent = 100 * Removed_OTUs / Total_OTUs,
    .groups = "drop"
  )

# Ensure the summary and plotted counts agree with actual filtering.
stopifnot(
  sum(otu_filter_overview$Retained_OTUs) ==
    nrow(filter_retained_otus(otu_12S_raw)) +
    nrow(filter_retained_otus(otu_16S_raw))
)

