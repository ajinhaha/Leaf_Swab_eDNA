clean_taxonomy <- function(df) {
  df %>%
    mutate(
      Genus = trimws(as.character(Genus)),
      Species = trimws(as.character(Species)),
      Genus = na_if(Genus, ""),
      Species = na_if(Species, ""),
      Genus = na_if(Genus, "NA"),
      Species = na_if(Species, "NA"),
      Taxon = case_when(
        !is.na(Species) ~ Species,
        !is.na(Genus) ~ paste0(Genus, "_sp."),
        TRUE ~ NA_character_
      )
    ) %>%
    select(-any_of(c("Note", "ID", "Seq", "Perc_ID", "English_Name")))
}

collapse_by_taxon <- function(df) {
  df %>%
    filter(!is.na(Taxon)) %>%
    group_by(Taxon) %>%
    summarise(
      Class = first(na.omit(Class)),
      Order = first(na.omit(Order)),
      Family = first(na.omit(Family)),
      Genus = first(na.omit(Genus)),
      Species = first(na.omit(Species)),
      IUCN = first(na.omit(IUCN)),
      Marker = first(Marker),
      N_otu_collapse = n(),
      across(where(is.numeric), ~ sum(.x, na.rm = TRUE)),
      .groups = "drop"
    )
}

filter_retained_otus <- function(df) {
  excluded_notes <- paste(
    c(
      "Control", "No_Borneo_Record", "No_Taxa", "Below_Genus",
      "NUMTs", "Human", "Domestic_Animal"
    ),
    collapse = "|"
  )
  
  control_columns <- c(
    "Control_Laboratory_Swab", "Control_Negative_Extraction",
    "Control_PCR_Lib1", "Control_PCR_Lib3", "Control_PCR_Lib4",
    "Control_PCR_Lib5", "Control_PCR_Lib6", "Control_PCR_Lib7",
    "Control_PCR_Lib8", "Control_PCR_Lib9", "Control_PCR_Lib10",
    "Control_PCR_Lib11", "Control_PCR_Lib12", "Control_PCR_Lib13",
    "Control_Positive_Swab"
  )
  
  df %>%
    filter(is.na(Note) | !str_detect(Note, regex(excluded_notes, ignore_case = TRUE))) %>%
    select(-any_of(control_columns))
}


