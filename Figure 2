    Genus = first(na.omit(Genus)),
    Species = first(na.omit(Species)),
    .groups = "drop"
  )

summarise_taxonomic_ranks <- function(df, marker_name) {
  tibble(
    Marker = marker_name,
    Taxon = n_distinct(df$Taxon, na.rm = TRUE),
    Species = n_distinct(df$Species, na.rm = TRUE),
    Genus = n_distinct(df$Genus, na.rm = TRUE),
    Family = n_distinct(df$Family, na.rm = TRUE),
    Order = n_distinct(df$Order, na.rm = TRUE),
    Class = n_distinct(df$Class, na.rm = TRUE)
  )
}

marker_summary <- bind_rows(
  summarise_taxonomic_ranks(otu_12S_collapse, "12S"),
  summarise_taxonomic_ranks(otu_16S_collapse, "16S"),
  summarise_taxonomic_ranks(otu_combined, "Combined")
)

