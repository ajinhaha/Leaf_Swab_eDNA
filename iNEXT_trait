# 02. USER SETTINGS -----------------------------------------------------------
# Change this path only if your analysis folder is elsewhere.
setwd("C:/Users/Fajrin/Desktop/Analysis_manuscript/")
output_dir <- "figures/iNEXT_ecological_traits/by_height"
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
seed <- 123L
nboot <- 200L
retry_nboot <- 400L
conf_level <- 0.95
knots <- 100L
height_levels <- c("Lower", "Middle", "Upper")
height_labels <- c("Lower (<1 m)", "Middle (1.3–1.5 m)", "Upper (2–2.5 m)")
trait_names <- c("Diet", "Body_size", "Locomotion")

# 03. READ ALL THREE ORIGINAL EXCEL FILES ------------------------------------
input_files <- c("Combined_12S_read_table.xlsx",
                 "Combined_16S_read_table.xlsx",
                 "Leaf_swab_taxa_ecological_traits.xlsx")
missing_files <- input_files[!file.exists(input_files)]
if (length(missing_files)) stop("Missing Excel files: ", paste(missing_files, collapse = ", "))
otu_12S <- read_excel(input_files[1])
otu_16S <- read_excel(input_files[2])
traits_raw <- read_excel(input_files[3])
names(otu_12S) <- trimws(names(otu_12S))
names(otu_16S) <- trimws(names(otu_16S))
names(traits_raw) <- trimws(names(traits_raw))

# 04. IDENTIFY THE 288 BIOLOGICAL SAMPLES ------------------------------------
# Control samples are not selected. Keep samples with zero detections.
sample_pattern <- "^(SWN|BBI|SBJ|KRB|SLP)_(Lower|Middle|Upper)_.+$"
sample_columns <- sort(union(
  grep(sample_pattern, names(otu_12S), value = TRUE),
  grep(sample_pattern, names(otu_16S), value = TRUE)
))
if (!length(sample_columns)) stop("No biological sample columns found.")
sample_height <- setNames(
  str_match(sample_columns, "^(?:SWN|BBI|SBJ|KRB|SLP)_(Lower|Middle|Upper)_")[, 2],
  sample_columns
)
print(table(factor(sample_height, levels = height_levels)))
if (length(sample_columns) != 288L) warning("Expected 288 biological samples; found ", length(sample_columns))

# 05. CLEAN TAXON NAMES AND COMBINE 12S + 16S -------------------------------
normalize_taxon <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c("", "NA", "NaN", "NULL")] <- NA_character_
  x
}
exclude_notes <- "Control|No_Borneo_Record|No_Taxa|Below_Genus|NUMTs|Human|Domestic_Animal"
prepare_marker <- function(df, marker) {
  required <- c("Genus", "Species", "Note")
  if (!all(required %in% names(df)))
    stop(marker, " missing columns: ", paste(setdiff(required, names(df)), collapse = ", "))
  for (s in setdiff(sample_columns, names(df))) df[[s]] <- 0
  df <- df %>%
    filter(!str_detect(coalesce(as.character(Note), ""), regex(exclude_notes, ignore_case = TRUE))) %>%
    mutate(
      Genus = normalize_taxon(Genus),
      Species = normalize_taxon(Species),
      Taxon = if_else(!is.na(Species), Species,
                      if_else(!is.na(Genus), paste0(Genus, "_sp."), NA_character_))
    ) %>%
    filter(!is.na(Taxon))
  df[sample_columns] <- lapply(df[sample_columns], function(v) {
    z <- suppressWarnings(as.numeric(as.character(v)))
    z[is.na(z)] <- 0
    if (any(!is.finite(z) | z < 0)) stop("Invalid read counts in ", marker)
    z
  })
  df %>% group_by(Taxon) %>%
    summarise(across(all_of(sample_columns), ~ sum(.x, na.rm = TRUE)), .groups = "drop")
}
combined_reads <- bind_rows(
  prepare_marker(otu_12S, "12S"),
  prepare_marker(otu_16S, "16S")
) %>% group_by(Taxon) %>%
  summarise(across(all_of(sample_columns), ~ sum(.x, na.rm = TRUE)), .groups = "drop")

# 06. JOIN TAXONOMIC ECOLOGICAL TRAITS ---------------------------------------
find_col <- function(df, candidates) {
  found <- intersect(candidates, names(df))
  if (!length(found)) stop("Trait column not found. Expected: ", paste(candidates, collapse = " / "))
  found[1]
}
trait_data <- data.frame(
  Taxon = normalize_taxon(traits_raw[[find_col(traits_raw, "Taxon")]]),
  Diet = normalize_taxon(traits_raw[[find_col(traits_raw, "Diet")]]),
  Body_size = normalize_taxon(traits_raw[[find_col(traits_raw,
    c("Body-size class", "Body_size", "Body size class"))]]),
  Locomotion = normalize_taxon(traits_raw[[find_col(traits_raw, "Locomotion")]]),
  stringsAsFactors = FALSE
) %>% filter(!is.na(Taxon))
if (anyDuplicated(trait_data$Taxon)) stop("Duplicate Taxon names in trait table.")
# Correct the two previously identified bat locomotion classifications.
trait_data$Locomotion[trait_data$Taxon %in%
  c("Balionycteris_maculata", "Mops_plicatus")] <- "Chiropteran volant"
unmatched <- anti_join(combined_reads, trait_data, by = "Taxon")
write.csv(unmatched %>% select(Taxon), file.path(output_dir, "unmatched_taxa.csv"), row.names = FALSE)
matched <- inner_join(combined_reads, trait_data, by = "Taxon")
if (!nrow(matched)) stop("No detected taxa matched the trait table.")
message("Matched taxa: ", nrow(matched), "; unmatched: ", nrow(unmatched))
incidence <- as.matrix(matched[, sample_columns, drop = FALSE])
storage.mode(incidence) <- "numeric"
incidence <- (incidence > 0) * 1L
rownames(incidence) <- matched$Taxon

# 07. FIXED CATEGORY COLOURS -------------------------------------------------
trait_palettes <- list(
  Diet = c(Omnivore = "#4477AA", Insectivore = "#228833",
           Frugivore = "#CCBB44", Herbivore = "#EE6677",
           Carnivore = "#AA3377", Other = "#66CCEE"),
  Body_size = c(Small = "#4477AA", Medium = "#228833", Large = "#EE7733"),
  Locomotion = c("Avian volant" = "#4477AA",
                 "Chiropteran volant" = "#AA3377",
                 Arboreal = "#228833", "Semi-arboreal" = "#CCBB44",
                 Terrestrial = "#EE7733", Aquatic = "#66CCEE")
)

# 08. FIT iNEXT BY TRAIT, HEIGHT, AND CATEGORY -------------------------------
# CRITICAL FIX: iNEXT incidence_raw takes a NAMED LIST of incidence matrices.
# We extract fit$iNextEst$size_based DIRECTLY, rather than relying on fortify().
# Each matrix retains all 96 height-specific samples, including empty samples.
# If bootstrap CI fails, retry with 400 replicates; if still unavailable,
# retain the valid richness curve and record missing uncertainty honestly.
all_curves <- list()
all_summary <- list()
fit_log <- list()
idx <- 0L

for (trait_name in trait_names) {
  categories <- sort(unique(na.omit(matched[[trait_name]])))
  for (height in height_levels) {
    hs <- names(sample_height)[sample_height == height]
    for (category in categories) {
      idx <- idx + 1L
      taxa <- matched$Taxon[!is.na(matched[[trait_name]]) & matched[[trait_name]] == category]
      mat <- incidence[taxa, hs, drop = FALSE]
      n_detected <- sum(rowSums(mat) > 0)
      all_summary[[idx]] <- data.frame(
        Trait = trait_name, Height = height, Assemblage = category,
        Samples = ncol(mat), Samples_with_detection = sum(colSums(mat) > 0),
        Observed_taxa = n_detected
      )
      if (n_detected == 0L) {
        fit_log[[idx]] <- data.frame(Trait = trait_name, Height = height,
          Assemblage = category, Attempt = "Skipped", Status = "Zero detections",
          Missing_CI = NA_integer_, Error = "")
        next
      }
      # Use the exact incidence matrix for this category and sampling height.
      # Keep taxa absent at this height; iNEXT may ignore zero-only rows.
      # Remove zero-only taxa for numerical stability, but NOT sample columns.
      mat <- mat[rowSums(mat) > 0, , drop = FALSE]
      run_fit <- function(boot, seed_offset = 0L) {
        set.seed(seed + idx + seed_offset)
        iNEXT::iNEXT(
          x = setNames(list(mat), category),
          q = 0, datatype = "incidence_raw", se = TRUE,
          conf = conf_level, nboot = boot, knots = knots,
          endpoint = 2 * ncol(mat)
        )
      }
      err <- ""
      fit <- tryCatch(run_fit(nboot), error = function(e) {
        err <<- conditionMessage(e)
        NULL
      })
      extract_curves <- function(obj) {
        if (is.null(obj) || is.null(obj$iNextEst$size_based)) return(NULL)
        z <- as.data.frame(obj$iNextEst$size_based)
        required <- c("Assemblage", "t", "Method", "qD")
        if (!all(required %in% names(z)))
          stop("Unexpected iNEXT size_based columns: ", paste(names(z), collapse = ", "))
        z <- z[is.na(z$Order.q) | z$Order.q == 0, , drop = FALSE]
        z$CI_lower <- if ("qD.LCL" %in% names(z)) z$qD.LCL else NA_real_
        z$CI_upper <- if ("qD.UCL" %in% names(z)) z$qD.UCL else NA_real_
        z
      }
      result <- tryCatch(extract_curves(fit), error = function(e) {
        err <<- paste(err, conditionMessage(e))
        NULL
      })
      attempt <- "Initial (200 bootstraps)"
      needs_retry <- is.null(result) ||
        (nrow(result) > 0 && all(is.na(result$CI_lower) | is.na(result$CI_upper)))
      if (needs_retry) {
        err_retry <- ""
        fit2 <- tryCatch(run_fit(retry_nboot, 100000L), error = function(e) {
          err_retry <<- conditionMessage(e)
          NULL
        })
        result2 <- tryCatch(extract_curves(fit2), error = function(e) {
          err_retry <<- paste(err_retry, conditionMessage(e))
          NULL
        })
        if (!is.null(result2) && nrow(result2)) result <- result2
        err <- paste(err, err_retry)
        attempt <- "Retry (400 bootstraps)"
      }
      # Last resort: compute point estimates with se=FALSE, without fake CIs.
      if (is.null(result) || !nrow(result)) {
        fit3 <- tryCatch(
          iNEXT::iNEXT(setNames(list(mat), category), q = 0,
            datatype = "incidence_raw", se = FALSE,
            knots = knots, endpoint = 2 * ncol(mat)),
          error = function(e) { err <<- paste(err, conditionMessage(e)); NULL }
        )
        result <- tryCatch(extract_curves(fit3), error = function(e) NULL)
        attempt <- "Point estimates only (no CI)"
      }
      if (is.null(result) || !nrow(result)) {
        fit_log[[idx]] <- data.frame(Trait = trait_name, Height = height,
          Assemblage = category, Attempt = attempt, Status = "FAILED",
          Missing_CI = NA_integer_, Error = trimws(err))
        warning("FAILED: ", trait_name, " / ", height, " / ", category, ": ", err)
        next
      }
      result$Trait <- trait_name
      result$Height <- height
      result$Assemblage <- category
      result$Curve_type <- result$Method
      all_curves[[length(all_curves) + 1L]] <- result
      missing_ci <- sum(is.na(result$CI_lower) | is.na(result$CI_upper))
      fit_log[[idx]] <- data.frame(Trait = trait_name, Height = height,
        Assemblage = category, Attempt = attempt,
        Status = if (missing_ci == 0) "CI complete" else "CI incomplete",
        Missing_CI = missing_ci, Error = trimws(err))
      message(sprintf("%-11s | %-6s | %-20s | %s | missing CI: %d",
                      trait_name, height, category, attempt, missing_ci))
    }
  }
}

