  Diet = normalise_taxon(traits_raw[[find_column(traits_raw, "Diet")]]),
  Body_size = normalise_taxon(traits_raw[[find_column(
    traits_raw, c("Body-size class", "Body_size", "Body size class"))]]),
  Locomotion = normalise_taxon(traits_raw[[find_column(traits_raw, "Locomotion")]])
) %>% filter(!is.na(Taxon))
