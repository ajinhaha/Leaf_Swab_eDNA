  Class = case_when(
    tolower(Class_raw) %in% c("mammalia", "mammal", "mammals") ~ "Mammalia",
    tolower(Class_raw) %in% c("aves", "bird", "birds") ~ "Aves",
    tolower(Class_raw) %in% c("actinopterygii", "actinopteri", "ray-finned fish", "fish", "fishes", "pisces") ~ "Actinopterygii",
    tolower(Class_raw) %in% c("chondrichthyes", "cartilaginous fish") ~ "Chondrichthyes",
    tolower(Class_raw) %in% c("amphibia", "amphibian", "amphibians") ~ "Amphibia",
    tolower(Class_raw) %in% c("reptilia", "reptile", "reptiles") ~ "Reptilia",
    TRUE ~ NA_character_
  )
)
if (anyNA(class_maps$Class)) {
  write.csv(class_maps %>% filter(is.na(Class)),
