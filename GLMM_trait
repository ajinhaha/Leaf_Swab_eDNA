# 07. EXTRACT SAMPLE METADATA ------------------------------------------------
# PlotID is defined by removing the _Lower_ / _Middle_ / _Upper_ substring
# from the sample name. Verify that each PlotID has exactly three heights.
meta <- tibble(SampleID = sample_columns) %>%
  mutate(
    Location = str_match(SampleID, "^(SWN|BBI|SBJ|KRB|SLP)_")[, 2],
    Height = str_match(SampleID, "_(Lower|Middle|Upper)_")[, 2],
    PlotID = str_replace(SampleID, "_(Lower|Middle|Upper)_", "_"),
    Height = factor(Height, levels = height_levels),
    Location = factor(Location, levels = location_levels),
    SampleID = factor(SampleID),
    PlotID = factor(PlotID)
  )
plot_check <- meta %>% count(PlotID, name = "n_heights")
write.csv(plot_check, file.path(output_dir, "plot_id_check.csv"), row.names = FALSE)
