# 05. COMBINE 12S AND 16S TAXON DETECTIONS -----------------------------------
normalise_taxon <- function(x) {
  x <- str_trim(as.character(x))
  x[x %in% c("", "NA", "NaN")] <- NA_character_
  x
}
exclude_notes <- "Control|No_Borneo_Record|No_Taxa|Below_Genus|NUMTs|Human|Domestic_Animal"

prepare_marker <- function(df, marker) {
  needed <- c("Genus", "Species", "Note")
  if (!all(needed %in% names(df))) {
    stop(marker, " missing columns: ", paste(setdiff(needed, names(df)), collapse = ", "))
  }
  for (s in setdiff(sample_columns, names(df))) df[[s]] <- 0
  df <- df %>%
    filter(!str_detect(coalesce(as.character(Note), ""),
                       regex(exclude_notes, ignore_case = TRUE))) %>%
    mutate(
      Genus = normalise_taxon(Genus),
      Species = normalise_taxon(Species),
      Taxon = if_else(!is.na(Species), Species,
                      if_else(!is.na(Genus), paste0(Genus, "_sp."), NA_character_))
    ) %>%
    filter(!is.na(Taxon))
  df[sample_columns] <- lapply(df[sample_columns], function(z) {
    z0 <- as.character(z)
    z <- suppressWarnings(as.numeric(z0))
    if (any(!is.na(z0) & trimws(z0) != "" & is.na(z))) {
      warning(marker, ": some nonnumeric counts were converted to zero")
    }
    z[is.na(z)] <- 0
    if (any(!is.finite(z) | z < 0)) stop("Invalid counts in ", marker)
    z
  })
  df %>% group_by(Taxon) %>%
    summarise(across(all_of(sample_columns), ~sum(.x)), .groups = "drop")
}

combined_reads <- bind_rows(
  prepare_marker(otu_12s, "12S"),
  prepare_marker(otu_16s, "16S")
) %>% group_by(Taxon) %>%
  summarise(across(all_of(sample_columns), ~sum(.x)), .groups = "drop")

# 06. MATCH ECOLOGICAL TRAITS ------------------------------------------------
find_column <- function(df, candidates) {
  hit <- intersect(candidates, names(df))
  if (!length(hit)) stop("Missing trait column; looked for: ",
                         paste(candidates, collapse = ", "))
  hit[1]
}
