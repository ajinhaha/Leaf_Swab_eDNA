# Determine taxonomic class from the trait table or either marker table.
# Do not infer mammal/bird status from diet, locomotion, or taxon names.
class_candidates <- c("Class", "class", "Taxonomic_class", "Taxonomic class")
get_class_map <- function(df, source_name) {
  class_col <- intersect(class_candidates, names(df))
  if (!length(class_col)) return(NULL)
  if ("Taxon" %in% names(df)) {
    taxon <- normalise_taxon(df$Taxon)
  } else if (all(c("Genus", "Species") %in% names(df))) {
    genus <- normalise_taxon(df$Genus)
    species <- normalise_taxon(df$Species)
    taxon <- ifelse(!is.na(species), species,
                    ifelse(!is.na(genus), paste0(genus, "_sp."), NA_character_))
  } else {
    stop("Class column found in ", source_name,
         " but Taxon or Genus/Species columns are missing")
  }
  tibble(Taxon = taxon,
         Class_raw = trimws(as.character(df[[class_col[1]]])),
         Source = source_name) %>%
    filter(!is.na(Taxon), !is.na(Class_raw), nzchar(Class_raw))
}
class_maps <- bind_rows(
  get_class_map(traits_raw, "traits"),
  get_class_map(otu_12s, "12S"),
  get_class_map(otu_16s, "16S")
)
if (!nrow(class_maps)) {
