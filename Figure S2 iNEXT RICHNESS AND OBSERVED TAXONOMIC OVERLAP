# iNEXT cannot estimate an assemblage with no observed taxa; fail explicitly.
validate_list <- function(x, title) {
  for (nm in names(x)) {
    if (ncol(x[[nm]]) == 0L || sum(x[[nm]]) == 0L) {
      stop(title, ' / ', nm, ': no samples or no detected taxa')
    }
  }
  invisible(TRUE)
}
validate_list(marker_list, 'Marker')
validate_list(height_list, 'Height')
validate_list(location_list, 'Location')

# 6. RUN iNEXT FOR MARKER, HEIGHT, AND LOCATION -----------------------------
# Fit incidence-based richness (q = 0) and sample coverage in one run.
run_inext <- function(assemblages) {
  # iNEXT takes one endpoint, based here on the largest assemblage.
  sample_counts <- vapply(assemblages, ncol, integer(1))
  endpoint <- extrapolation_multiplier * max(sample_counts)
  
  # Estimate curves and bootstrap confidence intervals.
  iNEXT::iNEXT(
    assemblages,
    q = 0,
    datatype = "incidence_raw",
    endpoint = endpoint,
    knots = n_knots,
    se = TRUE,
    conf = confidence_level,
    nboot = n_boot
  )
}

# Note: iNEXT's single endpoint is common across assemblages; the displayed
# curve for any group may exceed 2x its own effort if group sizes differ.
# For strict per-group 2x extrapolation, trim plotted curves below.
marker_inext <- run_inext(marker_list)

height_inext <- run_inext(height_list)

location_inext <- run_inext(location_list)

# 7. EXTRACT CURVES AND ENFORCE GROUP-SPECIFIC 2x EFFORT --------------------
extract_curves <- function(result, input_list, group_levels, type = 1) {
  # Type 1 gives richness; type 2 gives coverage. Both use effort on x.
  curves <- as.data.frame(ggplot2::fortify(result, type = type))
  
  # Check for the effort, estimate, method and confidence-interval columns.
  expected <- c("Assemblage", "x", "y", "Method", "y.lwr", "y.upr")
  missing_columns <- setdiff(expected, names(curves))
  if (length(missing_columns) > 0) {
    stop("Missing iNEXT curve columns: ",
         paste(missing_columns, collapse = ", "))
  }
  
  # Match each estimate to the maximum effort for its own assemblage.
  group_name <- as.character(curves$Assemblage)
  sample_counts <- vapply(input_list, ncol, integer(1))
  max_effort <- extrapolation_multiplier * sample_counts
  keep <- curves$x <= unname(max_effort[group_name])
  
  # Keep only estimates up to the effort limit.
  curves$Assemblage <- factor(group_name, levels = group_levels)
  curves$Method <- as.character(curves$Method)
  curves[keep, , drop = FALSE]
}

marker_curves <- extract_curves(marker_inext, marker_list, marker_levels)

height_curves <- extract_curves(height_inext, height_list, height_levels)

location_curves <- extract_curves(location_inext, location_list, location_levels)

# 8. PUBLICATION THEME AND iNEXT PANEL FUNCTION ----------------------------
publication_theme <- ggplot2::theme_classic(base_size = 12) +
  ggplot2::theme(
    axis.title = ggplot2::element_text(size = 13, face = 'bold', colour = 'black'),
    axis.text = ggplot2::element_text(size = 11, colour = 'black'),
