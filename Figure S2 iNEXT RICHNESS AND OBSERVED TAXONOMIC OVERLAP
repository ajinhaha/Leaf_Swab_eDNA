save_figure <- function(plot, basename, width, height) {
  ggplot2::ggsave(file.path(output_dir, paste0(basename, '.png')),
                  plot = plot, width = width, height = height, units = 'in',
                  dpi = 600, bg = 'white', limitsize = FALSE)
