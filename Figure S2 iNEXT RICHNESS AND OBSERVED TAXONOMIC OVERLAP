# Add a zoom window using the same estimates as in the main panel.
add_coverage_inset <- function(panel, curves, colours, x_range, y_range) {
  # Separate fitted curves from points at the observed sampling effort.
  is_observed <- curves$Method == "Observed"
  fitted <- curves[!is_observed, , drop = FALSE]
  observed <- curves[is_observed, , drop = FALSE]
  
  # Draw a compact copy of the curves with a tighter view.
  zoom <- ggplot(fitted, aes(x, y, colour = Assemblage)) +
    geom_ribbon(
      aes(ymin = y.lwr, ymax = y.upr, fill = Assemblage,
          group = interaction(Assemblage, Method)),
      alpha = 0.13, colour = NA, na.rm = TRUE
    ) +
    geom_line(
      aes(linetype = Method, group = interaction(Assemblage, Method)),
      linewidth = 0.55, na.rm = TRUE
    ) +
    geom_point(data = observed, size = 1.6) +
    scale_colour_manual(values = colours) +
    scale_fill_manual(values = colours) +
    scale_linetype_manual(
      values = c(Rarefaction = "solid", Extrapolation = "dashed")
    ) +
    scale_x_continuous(n.breaks = 4) +
    scale_y_continuous(
      labels = scales::label_percent(accuracy = 1), n.breaks = 4
    ) +
    coord_cartesian(xlim = x_range, ylim = y_range, expand = FALSE) +
    labs(x = NULL, y = NULL) +
    theme_bw(base_size = 9) +
    theme(
      legend.position = "none",
      panel.grid.minor = element_blank(),
      plot.margin = margin(4, 4, 4, 4)
    )
  
  # Outline the area enlarged in the inset.
  panel <- panel + annotate(
    "rect",
    xmin = x_range[1], xmax = x_range[2],
    ymin = y_range[1], ymax = y_range[2],
    fill = NA, colour = "grey40", linetype = "dotted"
  )
  
  # Place the inset below the curves in the lower-right of the panel.
  panel + patchwork::inset_element(
    zoom, left = 0.52, bottom = 0.06, right = 0.91, top = 0.54,
    align_to = "panel"
  )
}

