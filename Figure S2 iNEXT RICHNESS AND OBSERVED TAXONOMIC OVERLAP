  add_tag(panel_E, "E"), height_coverage, height_colours,
  height_zoom, height_coverage_zoom
)
panel_F_zoom <- add_coverage_inset(
  add_tag(panel_F, "F"), location_coverage, location_colours,
  location_zoom, location_coverage_zoom
)
coverage_row <- add_tag(panel_D, "D") | panel_E_zoom | panel_F_zoom

overlap_row <- wrap_upset(panel_G, "G") |
  wrap_upset(panel_H, "H") |
  wrap_upset(panel_I, "I")

# Give the UpSet row more space for its bars and intersection matrix.
figure_ABCDEFGHI <- (richness_row / coverage_row / overlap_row) +
