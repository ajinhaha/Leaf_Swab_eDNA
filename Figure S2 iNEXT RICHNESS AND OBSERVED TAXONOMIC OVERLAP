  )

# Place group names at the right end of each extrapolation curve.
# Labels use the same colour as their corresponding curve.
make_inext_panel <- function(curves, colours, title, x_label,
                             labels = NULL, coverage = FALSE) {
  # Split line estimates from the observed-effort points.
  line_rows <- curves$Method %in% c("Rarefaction", "Extrapolation")
  lines <- curves[line_rows, , drop = FALSE]
  observed <- curves[curves$Method == 'Observed', , drop = FALSE]
  
  # Prefer the furthest extrapolated estimate; otherwise use the furthest point.
  label_data <- lines %>%
    dplyr::group_by(Assemblage) %>%
    dplyr::arrange(
      dplyr::desc(Method == "Extrapolation"),
      dplyr::desc(x),
      .by_group = TRUE
    ) %>%
    dplyr::slice_head(n = 1) %>%
    dplyr::ungroup()
  if (!nrow(label_data)) stop('No iNEXT curve endpoints available for ', title)
  label_data$DirectLabel <- as.character(label_data$Assemblage)
  if (!is.null(labels)) {
    matched <- unname(labels[label_data$DirectLabel])
    label_data$DirectLabel[!is.na(matched)] <- matched[!is.na(matched)]
  }
  
  x_max <- max(lines$x, na.rm = TRUE)
  label_data$LabelX <- x_max * 1.04
  
  # Build a shared plot for richness and coverage.
  y_label <- if (coverage) "Sample coverage" else "Taxonomic richness"
  plot <- ggplot(lines, aes(x = x, y = y, colour = Assemblage)) +
    ggplot2::geom_ribbon(
      ggplot2::aes(ymin = y.lwr, ymax = y.upr, fill = Assemblage,
                   group = interaction(Assemblage, Method)),
      alpha = 0.13, colour = NA, na.rm = TRUE) +
    ggplot2::geom_line(ggplot2::aes(linetype = Method,
                                    group = interaction(Assemblage, Method)),
                       linewidth = 0.85, na.rm = TRUE) +
    ggplot2::geom_point(data = observed, size = 2.3, show.legend = FALSE) +
    ggrepel::geom_text_repel(
      data = label_data,
      ggplot2::aes(x = LabelX, y = y, label = DirectLabel, colour = Assemblage),
      inherit.aes = FALSE, direction = 'y', hjust = 0, size = 3.4,
      fontface = 'bold', min.segment.length = 0, segment.alpha = 0.5,
      box.padding = 0.15, point.padding = 0.1, max.overlaps = Inf,
      seed = 2026, show.legend = FALSE) +
    ggplot2::scale_colour_manual(values = colours, drop = FALSE) +
    ggplot2::scale_fill_manual(values = colours, guide = 'none') +
    ggplot2::scale_linetype_manual(
      values = c('Rarefaction' = 'solid', 'Extrapolation' = 'dashed')) +
    ggplot2::scale_x_continuous(expand = ggplot2::expansion(mult = c(0.02, 0.30))) +
    ggplot2::labs(title = title, x = x_label, y = y_label) +
    publication_theme
  
  # Display coverage estimates as percentages.
  if (coverage) {
    plot <- plot +
      scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
      coord_cartesian(ylim = c(0, 1), clip = "off")
  } else {
    plot <- plot + coord_cartesian(clip = "off")
  }
  
  plot
}

