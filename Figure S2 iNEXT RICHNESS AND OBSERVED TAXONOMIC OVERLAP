# 11. COMBINE INTO ONE NINE-PANEL FIGURE ------------------------------------
# ComplexUpset is itself a composite ggplot; wrap it so automatic tags do
# not label internal elements. Explicit plot tags are used for A-F.
# G/H/I are tagged using a narrow title overlay to avoid internal tag issues.
wrap_upset <- function(plot, tag) {
  tag_plot <- ggplot2::ggplot() +
    ggplot2::annotate('text', x = 0, y = 1, label = tag,
                      hjust = 0, vjust = 1, fontface = 'bold', size = 6) +
    ggplot2::xlim(0, 1) + ggplot2::ylim(0, 1) + ggplot2::theme_void()
  patchwork::wrap_elements(full = plot) +
    patchwork::inset_element(tag_plot, left = 0.005, bottom = 0.89,
                             right = 0.08, top = 0.995, align_to = 'full')
}

add_tag <- function(plot, tag) {
  plot + ggplot2::labs(tag = tag) +
    ggplot2::theme(plot.tag = ggplot2::element_text(face = 'bold', size = 19),
                   plot.tag.position = c(0.01, 0.99))
}

# Arrange richness, coverage, and UpSet plots from top to bottom.
richness_row <- add_tag(panel_A, "A") |
  add_tag(panel_B, "B") |
  add_tag(panel_C, "C")

# Tag the main panels before inserting the zoom plots.
