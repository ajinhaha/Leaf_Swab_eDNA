# These labels include both the older and newer Figure 2 filtering vocabulary.
excluded_notes <- c('Control', 'No_Borneo_Record', 'No_Taxa',
                    'No_BLAST_Hits', 'Below_Genus', 'Above_Genus_Level',
                    'NUMTs', 'Human', 'Domestic_Animal')
excluded_pattern <- paste(excluded_notes, collapse = '|')

# Only named biological leaf swabs are included; controls cannot match this.
sample_pattern <- '^(SWN|BBI|SBJ|KRB|SLP)_(Lower|Middle|Upper)_.+$'

# 3. CURATE EACH MARKER ------------------------------------------------------
prepare_marker <- function(raw_table, marker) {
  df <- as.data.frame(raw_table, check.names = FALSE)
  names(df) <- trimws(names(df))
  if (anyDuplicated(names(df))) stop(marker, ': duplicate column names')
  needed <- c('Genus', 'Species', 'Note')
  if (!all(needed %in% names(df))) {
    stop(marker, ': missing columns: ',
         paste(setdiff(needed, names(df)), collapse = ', '))
  }
  sample_cols <- grep(sample_pattern, names(df), value = TRUE)
  if (!length(sample_cols)) stop(marker, ': no valid biological sample columns')
  
  notes <- as.character(df$Note)
  exclude <- grepl(excluded_pattern, notes, ignore.case = TRUE)
  exclude[is.na(exclude)] <- FALSE
  df <- df[!exclude, , drop = FALSE]
  
  genus <- trimws(as.character(df$Genus))
  species <- trimws(as.character(df$Species))
  genus[toupper(genus) %in% c('', 'NA', 'N/A', 'NULL')] <- NA_character_
  species[toupper(species) %in% c('', 'NA', 'N/A', 'NULL')] <- NA_character_
  df$Taxon <- ifelse(!is.na(species), species,
                     ifelse(!is.na(genus), paste0(genus, '_sp.'), NA_character_))
  df <- df[!is.na(df$Taxon), , drop = FALSE]
  if (!nrow(df)) stop(marker, ': no retained taxonomic records')
  
  for (nm in sample_cols) {
    original <- trimws(as.character(df[[nm]]))
    numeric_values <- suppressWarnings(as.numeric(original))
    invalid <- !is.na(original) & original != '' & is.na(numeric_values)
    if (any(invalid)) stop(marker, ': nonnumeric counts in ', nm)
    numeric_values[is.na(numeric_values)] <- 0
    if (any(numeric_values < 0)) stop(marker, ': negative counts in ', nm)
    df[[nm]] <- numeric_values
  }
  
  # Multiple OTUs with the same final taxon are one biological taxon.
  collapsed <- df %>%
    dplyr::select(Taxon, dplyr::all_of(sample_cols)) %>%
    dplyr::group_by(Taxon) %>%
    dplyr::summarise(dplyr::across(dplyr::all_of(sample_cols), sum),
                     .groups = 'drop')
  matrix_out <- as.matrix(collapsed[, sample_cols, drop = FALSE])
  storage.mode(matrix_out) <- 'numeric'
  rownames(matrix_out) <- collapsed$Taxon
  matrix_out <- (matrix_out > 0) * 1L
  matrix_out
}

incidence_12S <- prepare_marker(otu_12S_raw, '12S')
incidence_16S <- prepare_marker(otu_16S_raw, '16S')

# 4. ALIGN SAMPLES AND COMBINE MARKERS --------------------------------------
# Missing columns in one marker represent zero detections for that marker.
# Warn rather than silently requiring identical column sets.
all_samples <- sort(union(colnames(incidence_12S), colnames(incidence_16S)))

align_incidence <- function(mat, taxa, samples) {
  result <- matrix(0L, nrow = length(taxa), ncol = length(samples),
                   dimnames = list(taxa, samples))
  result[rownames(mat), colnames(mat)] <- mat
  result
}

