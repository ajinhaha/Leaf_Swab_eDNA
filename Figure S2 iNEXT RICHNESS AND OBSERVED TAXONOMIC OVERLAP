summarise_assemblages <- function(x, factor_name) {
  data.frame(
    Factor = factor_name,
    Group = names(x),
    Sampling_units = vapply(x, ncol, integer(1)),
    Zero_detection_units = vapply(x, function(z) sum(colSums(z) == 0), integer(1)),
    Observed_taxa = vapply(x, function(z) sum(rowSums(z) > 0), integer(1)),
    row.names = NULL
  )
}

