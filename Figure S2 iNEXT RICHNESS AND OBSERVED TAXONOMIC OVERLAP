# 9. BUILD TAXON MEMBERSHIP TABLES FOR UPSET -------------------------------
# An intersection contains taxa detected in exactly the indicated sets.
# 'Combined' is excluded from marker UpSet because it is the union of 12S/16S,
# not an independent third marker.
make_membership <- function(x, levels) {
  taxa <- sort(unique(unlist(lapply(x, rownames))))
  out <- data.frame(Taxon = taxa, check.names = FALSE)
  for (nm in levels) {
    mat <- x[[nm]]
    present_taxa <- rownames(mat)[rowSums(mat) > 0]
    out[[nm]] <- taxa %in% present_taxa
  }
  out <- out[rowSums(out[, levels, drop = FALSE]) > 0, , drop = FALSE]
  out
}

marker_membership <- make_membership(marker_list[c('12S', '16S')], c('12S', '16S'))

height_membership <- make_membership(height_list[height_levels], height_levels)

location_membership <- make_membership(location_list, location_levels)

# 10. DRAW MARKER-COLOURED UPSET INTERSECTIONS -----------------------------
# The upper bars in ALL UpSet panels are coloured by marker detection:
# 12S = detected by 12S only anywhere in the dataset;
# 16S = detected by 16S only anywhere in the dataset;
# Combined = detected by BOTH markers somewhere in the dataset.
# These are mutually exclusive taxon categories, not three independent sets.
# A height/location intersection can contain taxa from all three categories.
# Accordingly, its upper bar is stacked by marker category, and its TOTAL
# height remains the number of taxa in that exact height/location intersection.
# IMPORTANT: marker category is defined globally across all samples, not
# separately within each height/location intersection.

marker_detected_12S <- rowSums(incidence_12S) > 0

marker_detected_16S <- rowSums(incidence_16S) > 0

marker_category <- ifelse(
  marker_detected_12S & marker_detected_16S, 'Both',
  ifelse(marker_detected_12S, '12S', '16S')
)

names(marker_category) <- rownames(incidence_combined)

add_marker_category <- function(membership) {
  membership$Marker_category <- factor(
    unname(marker_category[as.character(membership$Taxon)]),
    levels = c('12S', '16S', 'Both')
  )
  if (anyNA(membership$Marker_category)) {
    stop('UpSet membership includes taxa without a marker classification')
  }
  membership
}

marker_membership <- add_marker_category(marker_membership)

height_membership <- add_marker_category(height_membership)

location_membership <- add_marker_category(location_membership)

