# Create an UpSet plot with an optional marker legend.
make_upset_panel <- function(membership, sets, title,
                             show_legend = FALSE) {
  
  # --------------------------------------------------------------
  # UPPER BARS: TAXONOMIC UNIQUENESS
  # --------------------------------------------------------------
  # Stack marker contributions within each intersection.
  # Colours represent 12S, 16S, and Combined.
  # Numbers above bars indicate total intersection sizes.
  
  intersection_bar <- ComplexUpset::intersection_size(
    mapping = ggplot2::aes(fill = Marker_category),
    counts = TRUE,
    text = list(size = 2.6)
  ) +
    ggplot2::scale_fill_manual(
      values = upset_marker_colours,
      limits = names(upset_marker_colours),
      drop = FALSE,
      name = "Detected by",
      guide = if (show_legend) "legend" else "none"
    ) +
    ggplot2::labs(
      y = "Taxonomic uniqueness"
    )
  
  # --------------------------------------------------------------
  # LEFT BARS: TAXONOMIC RICHNESS
  # --------------------------------------------------------------
  # Show the total number of taxa detected within each set.
  
  set_size_bar <- ComplexUpset::upset_set_size() +
    ggplot2::labs(
      y = "Taxonomic richness"
    )
  
  # --------------------------------------------------------------
  # BUILD THE COMPLETE UPSET PLOT
  # --------------------------------------------------------------
  
  ComplexUpset::upset(
    membership,
    intersect = sets,
    min_size = 1,
    sort_intersections_by = "cardinality",
    sort_sets = FALSE,
    width_ratio = 0.20,
    name = "Group",
    
    base_annotations = list(
      "Taxonomic uniqueness" = intersection_bar
    ),
    
    set_sizes = set_size_bar
  ) +
    ggplot2::labs(title = title) +
    ggplot2::theme(
      plot.title = ggplot2::element_text(
        face = "bold",
        size = 14
      ),
      text = ggplot2::element_text(size = 10),
      legend.position = if (show_legend) "right" else "none",
      legend.title = ggplot2::element_text(
        size = 9,
        face = "bold"
      ),
      legend.text = ggplot2::element_text(size = 8),
      legend.key.size = grid::unit(0.35, "cm"),
      plot.margin = ggplot2::margin(8, 8, 8, 8)
    )
}

