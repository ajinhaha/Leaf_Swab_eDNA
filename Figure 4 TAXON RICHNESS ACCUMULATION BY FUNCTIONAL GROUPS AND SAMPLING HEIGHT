)
print(ci_diag %>% filter(Trait == "Locomotion", Height == "Middle"), n = Inf)


# ================================================================
# 10. PLOT EACH TRAIT x HEIGHT PANEL
# ================================================================
# Requires existing objects: curves_df, trait_palettes, height_labels,
# height_levels, output_dir. No iNEXT models are rerun.


make_panel <- function(trait_name, height, panel_tag = NULL) {
  dat <- curves_df %>% filter(Trait == trait_name, Height == height)
  if (nrow(dat) == 0L) stop("No curves for ", trait_name, " / ", height)
  palette <- trait_palettes[[trait_name]]
  extra <- setdiff(unique(as.character(dat$Assemblage)), names(palette))
  if (length(extra)) {
    warning("Unrecognised ", trait_name, " categories: ", paste(extra, collapse = ", "))
    palette <- c(palette, setNames(grDevices::hcl.colors(length(extra), "Dark 3"), extra))
  }
  dat$Assemblage <- factor(dat$Assemblage, levels = names(palette))
  lines <- dat %>% filter(Method %in% c("Rarefaction", "Extrapolation"))
  ribbons <- lines %>% filter(is.finite(CI_lower), is.finite(CI_upper))
  observed <- dat %>% filter(Method == "Observed")

  # Find the last finite point for each group in this panel.
  endpoints <- dat %>%
    filter(is.finite(t), is.finite(qD)) %>%
    group_by(Assemblage) %>%
    slice_max(t, n = 1, with_ties = FALSE) %>%
    ungroup()

  # Align labels just beyond the longest curve in the panel.
  last_sample <- max(endpoints$t)
  label_x <- last_sample * 1.04
  endpoints$Label <- str_wrap(as.character(endpoints$Assemblage), 14)

  p <- ggplot() +
    # Draw confidence bands where both interval bounds are available.
    geom_ribbon(
      data = ribbons,
      aes(x = t, ymin = CI_lower, ymax = CI_upper,
          fill = Assemblage, group = interaction(Assemblage, Method)),
      alpha = 0.14, colour = NA, show.legend = FALSE
    ) +
    # Use solid rarefaction lines and dashed extrapolation lines.
    geom_line(
      data = lines,
      aes(x = t, y = qD, colour = Assemblage, linetype = Method,
          group = interaction(Assemblage, Method)),
      linewidth = 1.05, na.rm = TRUE
    ) +
    # Mark the observed sampling effort.
    geom_point(
      data = observed,
      aes(x = t, y = qD, colour = Assemblage),
      size = 2.5, na.rm = TRUE, show.legend = FALSE
    ) +
    # Label each curve in its own colour and spread crowded labels vertically.
    ggrepel::geom_text_repel(
      data = endpoints,
      aes(x = t, y = qD, label = Label, colour = Assemblage),
      nudge_x = label_x - endpoints$t,
      direction = "y",
      hjust = 0,
      size = 3.3,
      fontface = "bold",
      min.segment.length = 0,
      segment.alpha = 0.45,
      box.padding = 0.2,
      max.overlaps = Inf,
      seed = seed,
      show.legend = FALSE
    ) +
    scale_colour_manual(values = palette, guide = "none") +
    scale_fill_manual(values = palette, guide = "none") +
    scale_linetype_manual(
      values = c(Rarefaction = "solid", Extrapolation = "dashed"),
      guide = "none"
    ) +
    # Reserve space for the labels while keeping ticks within sampling effort.
    scale_x_continuous(
      breaks = function(limits) {
        ticks <- pretty(c(0, last_sample))
        ticks[ticks >= 0 & ticks <= last_sample]
      },
      expand = expansion(mult = c(0.02, 0.25))
    ) +
    labs(
      # Show the height headings only in the top row (Diet).
      title = if (trait_name == "Diet") {
        height_labels[match(height, height_levels)]
      } else {
        NULL
      },
      
      # Show the x-axis title only in row C.
      x = if (trait_name == "Locomotion") "Number of leaf-swab samples",
      
      # Show the y-axis title only in the left column.
      y = if (height == "Lower") "Taxon richness"
    ) +
    theme_bw(base_size = 14) +
    theme(
      panel.grid.minor = element_blank(),
      panel.grid.major = element_line(colour = "grey92", linewidth = 0.2),
      plot.title = element_text(face = "bold", hjust = 0.5, size = 16,
                                margin = margin(b = 8)),
      axis.title.x = element_text(size = 14, margin = margin(t = 8)),
      axis.title.y = element_text(size = 14, margin = margin(r = 8)),
      axis.text.x = element_text(size = 12),
      axis.text.y = element_text(size = 12),
      plot.margin = margin(8, 8, 8, 8)
    )

  if (!is.null(panel_tag)) {
    p <- p + labs(tag = panel_tag) +
      theme(plot.tag = element_text(face = "bold", size = 22))
  }
  p
}

# ================================================================
# 11. COMBINE PANELS AND ADD ONE SHARED CURVE KEY
# ================================================================

# Place the three height panels for each trait side by side.
# Build one row with a heading above three equal-width panels.
build_row <- function(trait_name, tag) {
  # Create the three plots.
  panels <- cowplot::plot_grid(
    make_panel(trait_name, "Lower"),
    make_panel(trait_name, "Middle"),
    make_panel(trait_name, "Upper"),
    ncol = 3,
    align = "hv",
    axis = "tblr"
  )
  
  # Draw the row heading separately from the plots.
  heading <- cowplot::ggdraw() +
    cowplot::draw_label(
      tag,
      x = 0.008,
      hjust = 0,
      fontface = "bold",
      size = 17
    )
  
  # Give most of the row height to the plots.
  cowplot::plot_grid(
    heading,
    panels,
    ncol = 1,
    rel_heights = c(0.07, 1)
  )
}


