)
ci_diag <- curves_df %>%
  group_by(Trait, Height, Assemblage, Method) %>%
  summarise(N = n(), Missing_lower = sum(is.na(CI_lower)),
            Missing_upper = sum(is.na(CI_upper)),
            Mean_CI_width = if (all(is.na(CI_lower) | is.na(CI_upper))) NA_real_
            else mean(CI_upper - CI_lower, na.rm = TRUE),
            .groups = "drop")
write.csv(
  ci_diag,
  file.path(output_dir, "confidence_interval_diagnostics.csv"),
