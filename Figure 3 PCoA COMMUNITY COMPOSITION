# 4. BUILD COMBINED TAXON-BY-SAMPLE INCIDENCE MATRIX -----------------------
# Long format avoids incorrect column matching when marker tables
# contain different sample columns or a different column order.
# Convert each marker table to taxon–sample–read long format.
to_long <- function(df) {
  tidyr::pivot_longer(df, cols = -Taxon,
                      names_to = 'sample', values_to = 'reads')
}

# Merge markers and score a taxon as present if either marker detects it.
# Duplicate OTUs/taxa across markers are collapsed by the any(reads > 0) rule.
