# 6. HELPER: SORENSEN PCoA AND EXPLAINED VARIATION -------------------
# Sørensen dissimilarity on binary sample-by-taxon data.
# Cailliez additive correction (cmdscale(add = TRUE)) handles negative eigenvalues.
# The original Sørensen distances remain unchanged for hypothesis tests.
# Compute Sørensen dissimilarities and the corrected two-axis PCoA.
make_ordination <- function(comm) {
    # vegan's binary Bray-Curtis equals Sørensen dissimilarity.
  d <- vegan::vegdist(comm, method = 'bray', binary = TRUE)
  # Cailliez correction is used only to display non-Euclidean distances.
  ord <- stats::cmdscale(d, k = 2, eig = TRUE, add = TRUE)
  if (is.null(dim(ord$points)) || ncol(ord$points) < 2) {
    stop('Ordination has fewer than two axes.')
  }
  pos <- ord$eig[ord$eig > 1e-10]
  explained <- 100 * ord$eig[1:2] / sum(pos)
  scores <- as.data.frame(ord$points)
  names(scores) <- c('PCoA1', 'PCoA2')
  scores$sample <- rownames(scores)
  list(distance = d, ord = ord,
       scores = scores, explained = explained)
}

# 7. HELPER: PERMANOVA AND DISPERSION -----------------------------
# Height permutations must remain within PlotID. Location analysis
# is performed on independent plot-level pooled observations.
# Run PERMANOVA and a permutation test of multivariate dispersion.
run_tests <- function(d, grouping, blocks = NULL) {
  group <- droplevels(factor(grouping))
  if (nlevels(group) < 2) stop('At least two groups required.')
  if (length(group) != attr(d, 'Size')) stop('Grouping does not match distance matrix.')
  if (!is.null(blocks) && length(blocks) != length(group)) {
    stop('Permutation blocks do not match sample count.')
  }
  if (is.null(blocks)) {
    design <- permute::how(nperm = n_permutations)
  } else {
    design <- permute::how(nperm = n_permutations,
                           blocks = factor(blocks))
  }
  ad <- vegan::adonis2(d ~ group, permutations = design)
  # Bias adjustment is not used; test distances to group medians.
  bd <- vegan::betadisper(d, group, type = 'median')
  bd_perm <- vegan::permutest(bd, permutations = design)
  list(permanova = ad, dispersion = bd_perm,
       permanova_p = ad$`Pr(>F)`[1],
       dispersion_p = bd_perm$tab[1, 'Pr(>F)'])
}

# 8. HELPER: TAXON ENVFIT VECTORS --------------------------------------
# Fit taxon presence vectors to the first two PCoA axes.
# Height: 999 permutations constrained within plots.
# Location: 999 unrestricted permutations of independent pooled plots.
# Arrow direction indicates increasing taxon occurrence association.
# Length scales with sqrt(r-squared), then is rescaled for plotting.
# Arrows are descriptive, not causal or evidence of habitat preference.
# Fit and display up to eight taxa with exploratory, unadjusted P <= 0.05.
# All fitted taxon p-values are also exported for transparent reporting.
get_vectors <- function(ord, comm, scores_df, group_var,
                        palette, top_n = 8, blocks = NULL) {
  # Remove taxa with no occurrence variation (cannot fit vectors).
  variable_taxa <- apply(comm, 2, function(x) length(unique(x)) > 1)
  comm_fit <- comm[, variable_taxa, drop = FALSE]
  if (!ncol(comm_fit)) return(data.frame(Dim1 = numeric(), Dim2 = numeric(), Taxon = character(), pval = numeric(), r2 = numeric()))
  # Use the same permutation restriction as the corresponding PERMANOVA.
  permutation_design <- if (is.null(blocks)) {
    permute::how(nperm = n_permutations)
  } else {
    permute::how(nperm = n_permutations, blocks = factor(blocks))
  }
  fit <- vegan::envfit(ord$points, comm_fit,
                       permutations = permutation_design, na.rm = TRUE)
  if (is.null(fit$vectors) || !length(fit$vectors$pvals)) {
    return(data.frame(Dim1 = numeric(), Dim2 = numeric(), Taxon = character(), pval = numeric(), r2 = numeric()))
  }
  vec <- as.data.frame(vegan::scores(fit, display = 'vectors'))
  if (ncol(vec) < 2) return(data.frame(Dim1 = numeric(), Dim2 = numeric(), Taxon = character(), pval = numeric(), r2 = numeric()))
  names(vec)[1:2] <- c('Dim1', 'Dim2')
  vec$Taxon <- rownames(vec)
  # Match p-values and squared correlations by taxon name, not row order.
  vec$pval <- fit$vectors$pvals[vec$Taxon]
  vec$r2 <- fit$vectors$r[vec$Taxon]
  vec <- vec[!is.na(vec$pval) & vec$pval <= 0.05, , drop = FALSE]
  vec <- vec[order(vec$pval, -vec$r2), , drop = FALSE]
  vec <- head(vec, top_n)
  if (!nrow(vec)) return(vec)
  centroids <- scores_df %>%
    dplyr::group_by(group = .data[[group_var]]) %>%
    dplyr::summarise(Centroid1 = mean(PCoA1),
                     Centroid2 = mean(PCoA2), .groups = 'drop')
  best <- vapply(seq_len(nrow(vec)), function(i) {
    v <- as.numeric(vec[i, c('Dim1', 'Dim2')])
    similarities <- vapply(seq_len(nrow(centroids)), function(j) {
      c <- as.numeric(centroids[j, c('Centroid1', 'Centroid2')])
      if (sum(v^2) == 0 || sum(c^2) == 0) return(-Inf)
      sum(v * c) / sqrt(sum(v^2) * sum(c^2))
    }, numeric(1))
    if (all(!is.finite(similarities))) return(NA_character_)
    as.character(centroids$group[which.max(similarities)])
  }, character(1))
  vec$assigned_group <- best
  # Scale fitted direction vectors by sqrt(r2), then to plot dimensions.
  # vegan::scores(envfit, display = 'vectors') already scales arrows by sqrt(r2).
  # Do not multiply by sqrt(r2) again, which would exaggerate differences.
  # Retain the proportional fitted-vector lengths before uniform plot scaling.
  span <- min(diff(range(scores_df$PCoA1)),
              diff(range(scores_df$PCoA2)))
  max_length <- max(sqrt(vec$Dim1^2 + vec$Dim2^2))
  if (is.finite(max_length) && max_length > 0 && span > 0) {
    scale_factor <- 0.32 * span / max_length
    vec$Dim1 <- vec$Dim1 * scale_factor
    vec$Dim2 <- vec$Dim2 * scale_factor
  }
  vec
}

# Export every fitted taxon's envfit statistics, not only plotted taxa.
# This avoids treating the displayed top eight as the complete test results.
get_all_envfit <- function(ord, comm, blocks = NULL) {
  variable_taxa <- apply(comm, 2, function(x) length(unique(x)) > 1)
  comm_fit <- comm[, variable_taxa, drop = FALSE]
  if (!ncol(comm_fit)) {
    return(data.frame(Taxon = character(), r2 = numeric(), p = numeric()))
  }
  design <- if (is.null(blocks)) {
    permute::how(nperm = n_permutations)
  } else {
    permute::how(nperm = n_permutations, blocks = factor(blocks))
  }
  fit <- vegan::envfit(ord$points, comm_fit, permutations = design)
  out <- data.frame(
    Taxon = names(fit$vectors$pvals),
    r2 = as.numeric(fit$vectors$r[names(fit$vectors$pvals)]),
    p = as.numeric(fit$vectors$pvals),
    row.names = NULL
  )
  out$BH_adjusted_p <- p.adjust(out$p, method = 'BH')
  out[order(out$p, -out$r2), , drop = FALSE]
}

# 9. HELPER: PLOT PCoA --------------------------
# Draw points, 95% normal-theory group ellipses (not confidence intervals for centroids), test labels and optional taxon arrows.
make_plot <- function(scores_df, vectors, group_var, palette,
                      explained, stats, legend_title) {
  p_text <- paste0('PERMANOVA p = ',
                   format.pval(stats$permanova_p, digits = 4, eps = 0.001),
                   '\nDispersion p = ',
                   format.pval(stats$dispersion_p, digits = 3, eps = 0.001))
  p <- ggplot(scores_df, aes(PCoA1, PCoA2)) +
    stat_ellipse(aes(colour = .data[[group_var]],
                     group = .data[[group_var]]),
                 level = 0.95, linewidth = 0.85, alpha = 0.9,
                 show.legend = FALSE, na.rm = TRUE) +
    geom_point(aes(colour = .data[[group_var]]),
               size = 3.2, alpha = 0.75) +
    scale_colour_manual(values = palette, drop = FALSE) +
    labs(x = sprintf('PCoA1 (%.1f%%)', explained[1]),
         y = sprintf('PCoA2 (%.1f%%)', explained[2]),
         colour = legend_title) +
    annotate('label', x = -Inf, y = Inf, label = p_text,
             hjust = -0.04, vjust = 1.1, size = 4.8,
             label.size = 0.25, fill = 'white') +
    publication_theme +
    theme(legend.position = 'right')
  if (nrow(vectors) > 0) {
    p <- p +
      geom_segment(data = vectors,
                   aes(x = 0, y = 0, xend = Dim1, yend = Dim2),
                   inherit.aes = FALSE,
                   arrow = grid::arrow(length = grid::unit(0.23, 'cm')),
                   linewidth = 0.7, colour = '#52565A',
                   alpha = 0.85, show.legend = FALSE) +
      ggrepel::geom_text_repel(
        data = vectors,
        aes(x = Dim1, y = Dim2, label = gsub('_', ' ', Taxon)),
        inherit.aes = FALSE, size = 4.3,
        colour = '#404449', fontface = 'italic',
        max.overlaps = Inf, box.padding = 0.35,
        show.legend = FALSE, seed = 2026)
  }
  p
}

# 10. PANEL A: HEIGHT (INDIVIDUAL SWABS) --------------------------
# Transpose the incidence matrix to samples-by-taxa for Panel A.
comm_height <- t(incid)

# Calculate the height-level Sørensen PCoA.
ord_height <- make_ordination(comm_height)

# Attach height and plot metadata to ordination coordinates.
scores_height <- dplyr::left_join(ord_height$scores, info, by = 'sample')

# Test height effects while restricting permutations within plots.
stats_height <- run_tests(ord_height$distance, info$height,
                          blocks = info$PlotID)

# Identify taxa associated with the height-level ordination.
vectors_height <- get_vectors(ord_height$ord, comm_height,
                              scores_height, 'height', height_colors,
                              blocks = info$PlotID)

# Create the clean height panel without taxon vectors.
p_height <- make_plot(scores_height, vectors_height[0, , drop = FALSE], 'height',
                      height_colors, ord_height$explained,
                      stats_height, 'Vegetation height')

# Create the height panel with significant taxon vectors.
p_height_vectors <- make_plot(scores_height, vectors_height, 'height',
                              height_colors, ord_height$explained,
                              stats_height, 'Vegetation height')

# 11. PANEL B: LOCATION (HEIGHTS POOLED BY PLOT) ------------------
# Pool presence/absence within each location-plot combination.
# This preserves plots as the independent sampling units.
# Pool all vegetation heights within each plot by summing binary detections.
pooled <- rowsum(t(incid), group = info$PlotID, reorder = TRUE)

# Convert pooled counts back to presence–absence (0 or 1).
pooled[pooled > 0] <- 1

# Create one metadata record for each pooled plot.
info_plot <- info %>%
  dplyr::distinct(PlotID, location) %>%
  dplyr::mutate(sample = PlotID)

# Calculate info_plot.
info_plot <- info_plot[match(rownames(pooled), info_plot$sample), , drop = FALSE]

# Calculate the plot-level Sørensen PCoA for location comparisons.
ord_location <- make_ordination(pooled)

# Attach location metadata to plot-level ordination coordinates.
scores_location <- dplyr::left_join(ord_location$scores,
                                    info_plot, by = 'sample')

# Test location differences using independent pooled plots.
stats_location <- run_tests(ord_location$distance, info_plot$location)

# Identify taxa associated with the location-level ordination.
vectors_location <- get_vectors(ord_location$ord, pooled,
                                scores_location, 'location', location_colors)

# Create the clean location panel without taxon vectors.
p_location <- make_plot(scores_location, vectors_location[0, , drop = FALSE], 'location',
                        location_colors, ord_location$explained,
                        stats_location, 'Location')

# Create the location panel with significant taxon vectors.
p_location_vectors <- make_plot(scores_location, vectors_location, 'location',
                                location_colors, ord_location$explained,
                                stats_location, 'Location')

