# Export complete envfit tables with the correct permutation designs.
write.csv(get_all_envfit(ord_height$ord, comm_height, blocks = info$PlotID),
          file.path(output_dir, 'Envfit_Height_All_Taxa.csv'), row.names = FALSE)
write.csv(get_all_envfit(ord_location$ord, pooled),
          file.path(output_dir, 'Envfit_Location_All_Taxa.csv'), row.names = FALSE)

# ================================================================
# 16. PAIRWISE HEIGHT PERMANOVA — SUPPLEMENTARY TABLE
# ================================================================
# Compare all three height pairs using only complete paired plots.
# Restrict all permutations within plots and apply BH correction.
# Define the three planned comparisons.
height_pairs <- list(
  c("Lower", "Middle"),
  c("Lower", "Upper"),
  c("Middle", "Upper")
)

# Perform a separate restricted-permutation PERMANOVA for each pair.
run_pairwise_height <- function(pair) {
  # Keep only samples from the two vegetation heights under comparison.
  selected <- as.character(info$height) %in% pair
  metadata <- info[selected, , drop = FALSE]
  community <- comm_height[selected, , drop = FALSE]
  
  # Retain complete plots with one sample from each of the two heights.
  counts <- table(metadata$PlotID, factor(metadata$height, levels = pair))
  complete_plots <- rownames(counts)[rowSums(counts == 1L) == 2L]
  keep <- metadata$PlotID %in% complete_plots
  metadata <- metadata[keep, , drop = FALSE]
  community <- community[keep, , drop = FALSE]
  
  # Require at least two complete plots for a meaningful comparison.
  if (length(complete_plots) < 2L) {
    stop("Too few complete plots for comparison: ", paste(pair, collapse = " vs "))
  }
  
  # Recreate the binary factor and check alignment after subsetting.
  metadata$height <- factor(as.character(metadata$height), levels = pair)
  stopifnot(identical(rownames(community), as.character(metadata$sample)))
  
  # Compute Sørensen dissimilarity from the binary community matrix.
  distance <- vegan::vegdist(community, method = "bray", binary = TRUE)
  
  # Restrict permutation of height labels within each paired plot.
  permutation_design <- permute::how(
    nperm = n_permutations,
    blocks = factor(metadata$PlotID)
  )
  
  # Run PERMANOVA with height as the sole predictor.
  model <- vegan::adonis2(
    distance ~ height,
    data = metadata,
    permutations = permutation_design
  )
  
  # Extract the first (height) row of the PERMANOVA results.
  data.frame(
    Comparison = paste(pair, collapse = " vs "),
    Plots = length(complete_plots),
    Samples = nrow(metadata),
    Df = model$Df[1],
    Pseudo_F = model$F[1],
    R2 = model$R2[1],
    P_value = model$`Pr(>F)`[1],
    stringsAsFactors = FALSE
  )
}

# Combine results for the three comparisons.
pairwise_height_results <- do.call(
  rbind,
  lapply(height_pairs, run_pairwise_height)
)

# Adjust all three raw P-values for multiple comparisons (BH method).
pairwise_height_results$Adjusted_P_BH <- p.adjust(
  pairwise_height_results$P_value,
  method = "BH"
)

# Add a conventional significance flag based on adjusted P-values.
pairwise_height_results$Significant_BH_0_05 <-
  pairwise_height_results$Adjusted_P_BH <= 0.05

# Save the full-precision results for Supplementary Table SX.
output_file <- file.path(output_dir, "Supplementary_Table_SX_Pairwise_PERMANOVA_Height.csv")
write.csv(pairwise_height_results, output_file, row.names = FALSE)

# Display the table in the R console.
print(pairwise_height_results, row.names = FALSE)
message("Supplementary Table SX saved to: ", normalizePath(output_file))

# NOTE: If some plots have missing heights, this complete-pair analysis can
# use a different sample set from the overall height PERMANOVA. Report the
# number of plots per comparison in Supplementary Table SX.

# ================================================================
# 17. LOCATION-LEVEL SUPPLEMENTARY TESTS
# ================================================================
# The pooled plot-by-taxon matrix and aligned metadata already exist.
# Run ten pairwise location comparisons with Holm adjustment.
# Run pairwise dispersion tests to assess differences in variability.
# Export overall group dispersion and all taxon associations.
# Reuse the 999-permutation setting established above.

# DEFINE ALL 10 PAIRS OF THE FIVE SAMPLING LOCATIONS ----------------------
locations <- c('SWN', 'BBI', 'SBJ', 'KRB', 'SLP')

# Calculate location_pairs.
location_pairs <- combn(locations, 2, simplify = FALSE)

# PAIRWISE PERMANOVA USING BINARY SORENSEN DISSIMILARITY ------------------
# Each comparison uses only the plots belonging to the two locations.
# Because plots are independent, permutation labels are unrestricted.
run_location_pair <- function(pair) {
  keep <- as.character(info_plot$location) %in% pair
  meta <- info_plot[keep, , drop = FALSE]
  comm <- pooled[keep, , drop = FALSE]
  meta$location <- factor(as.character(meta$location), levels = pair)
  stopifnot(identical(rownames(comm), as.character(meta$sample)))
  d <- vegan::vegdist(comm, method = 'bray', binary = TRUE)
  model <- vegan::adonis2(d ~ location, data = meta, permutations = n_permutations)
  data.frame(Comparison = paste(pair, collapse = ' vs '),
             N_1 = sum(meta$location == pair[1]),
             N_2 = sum(meta$location == pair[2]),
             Plots = nrow(meta),
             Df = model$Df[1],
             Pseudo_F = model$F[1],
             R2 = model$R2[1],
             P_value = model$`Pr(>F)`[1])
}

# Calculate location_pairwise.
location_pairwise <- do.call(rbind, lapply(location_pairs, run_location_pair))

# Calculate location_pairwise$Adjusted_P_Holm.
location_pairwise$Adjusted_P_Holm <- p.adjust(location_pairwise$P_value,
                                              method = 'holm')

# Calculate location_pairwise$Significant_Holm_0_05.
location_pairwise$Significant_Holm_0_05 <-
  location_pairwise$Adjusted_P_Holm <= 0.05

write.csv(location_pairwise,
          file.path(output_dir, 'Supplementary_Location_Pairwise_PERMANOVA.csv'),
          row.names = FALSE)

# OVERALL LOCATION DISPERSION: DISTANCE TO GROUP MEDIAN ------------------
# vegan::betadisper defaults to type='median'; specify explicitly.
# These means summarize the FULL five-location ordination, not a pairwise
# re-fitted dispersion analysis.
full_distance <- vegan::vegdist(pooled, method = 'bray', binary = TRUE)

# Calculate full_group.
full_group <- droplevels(factor(info_plot$location, levels = locations))

# Calculate full_bd.
full_bd <- vegan::betadisper(full_distance, full_group, type = 'median')

# Calculate overall_dispersion.
overall_dispersion <- data.frame(
  Location = locations,
  N_plots = as.integer(table(full_group)[locations]),
  Mean_distance_to_median = as.numeric(tapply(full_bd$distances,
                                              full_group, mean)[locations]),
  SD_distance_to_median = as.numeric(tapply(full_bd$distances,
                                            full_group, sd)[locations]))
write.csv(overall_dispersion,
          file.path(output_dir, 'Supplementary_Location_Overall_Dispersion.csv'),
          row.names = FALSE)

# PAIRWISE DISPERSION TESTS ----------------------------------------------
# Re-fit betadisper for each two-location subset so that the test is based
# on the medians of those two groups; test with 999 permutations.
# These tests address differences in within-group variability, not centroid
# separation. Holm correction is applied across the 10 comparisons.
run_dispersion_pair <- function(pair) {
  keep <- as.character(info_plot$location) %in% pair
  meta <- info_plot[keep, , drop = FALSE]
  comm <- pooled[keep, , drop = FALSE]
  group <- factor(as.character(meta$location), levels = pair)
  d <- vegan::vegdist(comm, method = 'bray', binary = TRUE)
  bd <- vegan::betadisper(d, group, type = 'median')
  test <- vegan::permutest(bd, permutations = n_permutations)
  means <- tapply(bd$distances, group, mean)
  data.frame(Comparison = paste(pair, collapse = ' vs '),
             Location_1 = pair[1], Location_2 = pair[2],
             N_1 = sum(group == pair[1]), N_2 = sum(group == pair[2]),
             Mean_dispersion_1 = unname(means[pair[1]]),
             Mean_dispersion_2 = unname(means[pair[2]]),
             Difference_1_minus_2 = unname(means[pair[1]] - means[pair[2]]),
             F = unname(test$tab[1, 'F']),
             P_value = unname(test$tab[1, 'Pr(>F)']))
}

# Calculate location_dispersion_pairs.
location_dispersion_pairs <- do.call(rbind,
                                     lapply(location_pairs, run_dispersion_pair))

# Calculate location_dispersion_pairs$Adjusted_P_Holm.
location_dispersion_pairs$Adjusted_P_Holm <-
  p.adjust(location_dispersion_pairs$P_value, method = 'holm')

# Calculate location_dispersion_pairs$Significant_Holm_0_05.
location_dispersion_pairs$Significant_Holm_0_05 <-
  location_dispersion_pairs$Adjusted_P_Holm <= 0.05

write.csv(location_dispersion_pairs,
          file.path(output_dir, 'Supplementary_Location_Pairwise_Dispersion.csv'),
          row.names = FALSE)

# ALL TAXON ENVFIT ASSOCIATIONS ------------------------------------------
# envfit treats each binary taxon as a numeric vector (0/1). Fit all taxa
# with variable occurrence; constant taxa cannot yield informative vectors.
# Permutations are unrestricted because plot-level observations are independent.
variable_taxa <- apply(pooled, 2, function(x) length(unique(x)) > 1)

# Calculate comm_envfit.
comm_envfit <- pooled[, variable_taxa, drop = FALSE]

set.seed(2026) # Keep the supplementary envfit permutation results reproducible.

# Calculate fit.
fit <- vegan::envfit(ord_location$ord$points, comm_envfit,
                     permutations = n_permutations, na.rm = TRUE)

# Calculate vec.
vec <- as.data.frame(vegan::scores(fit, display = 'vectors', choices = 1:2))

# Calculate names(vec)[1:2].
names(vec)[1:2] <- c('PCoA1_direction', 'PCoA2_direction')

# Calculate vec$Taxon.
vec$Taxon <- rownames(vec)

# Calculate vec$R2.
vec$R2 <- unname(fit$vectors$r[vec$Taxon])

# Calculate vec$P_value.
vec$P_value <- unname(fit$vectors$pvals[vec$Taxon])

# Calculate vec$BH_adjusted_P_exploratory.
vec$BH_adjusted_P_exploratory <- p.adjust(vec$P_value, method = 'BH')

# Calculate vec$Significant_unadjusted_0_05.
vec$Significant_unadjusted_0_05 <- vec$P_value <= 0.05

# Calculate vec.
vec <- vec[, c('Taxon', 'PCoA1_direction', 'PCoA2_direction',
               'R2', 'P_value', 'BH_adjusted_P_exploratory',
               'Significant_unadjusted_0_05')]
# Calculate vec.
vec <- vec[order(vec$P_value, -vec$R2), , drop = FALSE]

write.csv(vec, file.path(output_dir,
                         'Supplementary_Location_Envfit_All_Taxa.csv'),
          row.names = FALSE)

write.csv(vec[vec$Significant_unadjusted_0_05, , drop = FALSE],
          file.path(output_dir,
                    'Supplementary_Location_Envfit_Significant_Taxa.csv'),
          row.names = FALSE)

# OVERALL PERMANOVA STATISTICS -------------------------------------------
