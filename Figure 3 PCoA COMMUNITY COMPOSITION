# Each panel receives its own centred legend beneath the axes.
# This must be applied BEFORE the panels are combined and exported.
format_bottom_legend <- function(plot, title) {
  plot +
    theme(
      legend.position = 'bottom',
      legend.justification = 'center',
      legend.direction = 'horizontal',
      legend.title = element_text(size = 17, face = 'bold'),
      legend.text = element_text(size = 16),
      legend.spacing.x = grid::unit(0.15, 'cm'),
      legend.box.margin = margin(t = 5)
    ) +
    guides(colour = guide_legend(title = title, nrow = 1,
                                 title.position = 'left'))
}

