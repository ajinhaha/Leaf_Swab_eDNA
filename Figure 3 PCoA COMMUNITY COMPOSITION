                   'Species', 'IUCN', 'Marker', 'Note', 'ID',
                   'Seq', 'Perc_ID', 'English_Name')

# Clean a marker table and return taxon names with numeric sample counts.
prepare_marker <- function(df, marker) {
  
  # Convert the imported tibble into a standard data frame.
  # check.names = FALSE preserves the original sample column names.
  df <- as.data.frame(df, check.names = FALSE)
  
  # Remove leading and trailing spaces from column names.
  names(df) <- trimws(names(df))
  required <- c('Genus', 'Species', 'Note')
  if (!all(required %in% names(df))) {
    stop('Missing columns for ', marker, ': ',
         paste(setdiff(required, names(df)), collapse = ', '))
  }
  notes <- as.character(df$Note)
  exclude <- grepl(excluded_pattern, notes, ignore.case = TRUE)
  exclude[is.na(exclude)] <- FALSE
  df <- df[!exclude, , drop = FALSE]
  # Stop if curation leaves no taxonomic records.
  if (!nrow(df)) stop('No retained OTUs for ', marker)
  genus <- trimws(as.character(df$Genus))
  species <- trimws(as.character(df$Species))
  genus[genus %in% c('', 'NA', 'N/A')] <- NA_character_
  species[species %in% c('', 'NA', 'N/A')] <- NA_character_
  df$Taxon <- ifelse(!is.na(species), species,
                     ifelse(!is.na(genus), paste0(genus, '_sp.'), NA_character_))
  df <- df[!is.na(df$Taxon), , drop = FALSE]
  df$Marker <- marker
  sample_cols <- setdiff(names(df), metadata_cols)
  # Remove any controls, including newly added PCR control columns.
  # Only accept sample names matching LOCATION_HEIGHT_PLOT.
  # This excludes controls and unexpected metadata columns automatically.
  sample_cols <- sample_cols[grepl('^(SWN|BBI|SBJ|KRB|SLP)_(Lower|Middle|Upper)_.+$', sample_cols)]
  if (!length(sample_cols)) stop('No sample columns found for ', marker)
  for (nm in sample_cols) {
    val <- suppressWarnings(as.numeric(as.character(df[[nm]])))
    if (any(is.na(val) & !is.na(df[[nm]]) &
            trimws(as.character(df[[nm]])) != '')) {
      stop('Non-numeric read counts for ', marker, ': ', nm)
    }
    df[[nm]] <- tidyr::replace_na(val, 0)
    if (any(df[[nm]] < 0)) stop('Negative read count in ', nm)
  }
  df[, c('Taxon', sample_cols), drop = FALSE]
}

