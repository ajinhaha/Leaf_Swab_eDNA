# 3. FILTER AND CURATE MARKER TABLES
# IMPORTANT: This workflow combines taxa by their labels. Review species/genus
excluded_pattern <- paste(c('Control', 'No_Borneo_Record', 'No_BLAST_Hits',
                            'Below_Genus', 'Above_Genus_Level', 'NUMTs',
