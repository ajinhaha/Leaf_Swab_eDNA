# 8. PANEL D | TAXONOMIC RECOVERY ---------------------------------------------
# Collapse within markers, then across markers, retaining IUCN and provenance.
otu_12S_collapse <- collapse_by_taxon(clean_taxonomy(otu_12S_retained), "12S")
otu_16S_collapse <- collapse_by_taxon(clean_taxonomy(otu_16S_retained), "16S")

# One row per distinct Taxon, with marker(s) in which it was detected.
otu_combined <- bind_rows(otu_12S_collapse, otu_16S_collapse) %>%
  group_by(Taxon) %>%
  summarise(across(c(Class, Order, Family, Genus, Species, IUCN), first_available),
            Marker = paste(sort(unique(Marker)), collapse = "+"),
            IUCN_conflict = n_distinct(na.omit(IUCN)) > 1,
            .groups = "drop")

# Counts used in Figure 2D. n_distinct excludes missing assignments.
summarise_taxonomic_ranks <- function(df, marker_name) {
  tibble(Marker = marker_name,
         Taxon = n_distinct(df$Taxon, na.rm = TRUE),
         Species = n_distinct(df$Species, na.rm = TRUE),
         Genus = n_distinct(df$Genus, na.rm = TRUE),
         Family = n_distinct(df$Family, na.rm = TRUE),
         Order = n_distinct(df$Order, na.rm = TRUE),
         Class = n_distinct(df$Class, na.rm = TRUE))
}
marker_summary <- bind_rows(
  summarise_taxonomic_ranks(otu_12S_collapse, "12S"),
  summarise_taxonomic_ranks(otu_16S_collapse, "16S"),
  summarise_taxonomic_ranks(otu_combined, "Combined"))
marker_long <- marker_summary %>%
  pivot_longer(
    cols = c(Taxon, Species, Genus, Family, Order, Class),
    names_to = "Rank",
    values_to = "Count"
  ) %>%
  mutate(
    Rank = factor(
      Rank,
      levels = c("Taxon", "Species", "Genus",
                 "Family", "Order", "Class"),
      labels = c("Total taxa", "Species", "Genera",
                 "Families", "Orders", "Classes")
    ),
    Marker = factor(
      Marker,
      levels = c("12S", "16S", "Combined")
    )
  )

