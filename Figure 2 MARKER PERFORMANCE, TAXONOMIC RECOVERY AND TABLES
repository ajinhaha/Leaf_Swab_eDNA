# Count each exclusion reason for each marker.
# A note with multiple matching reasons contributes to each matching count.
count_filter_categories <- function(df, marker_name) {
  matches <- exclusion_matches(df)
  multiple_reasons <- sum(rowSums(matches) > 1)
  if (multiple_reasons > 0) {
    warning(marker_name, ": ", multiple_reasons,
            " OTUs have multiple exclusion reasons in Panel B.")
  }

  tibble(Marker = marker_name, Category = filter_categories,
         Count = as.integer(colSums(matches)))
}
removed_df <- bind_rows(count_filter_categories(otu_12S_raw, "12S"),
                        count_filter_categories(otu_16S_raw, "16S"))
retained_df <- tibble(Marker = c("12S", "16S"),
                      Category = "Retained_OTUs",
