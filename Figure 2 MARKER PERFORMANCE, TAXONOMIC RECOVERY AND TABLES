# 3. TAXONOMY AND FILTERING HELPERS -------------------------------------------
# Return the first recorded value, or NA if every entry is missing.
first_available <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c("", "NA", "N/A")] <- NA_character_
  values <- x[!is.na(x)]
  if (length(values) == 0) {
    return(NA_character_)
  }

  values[1]
}

filter_categories <- c("Control", "No_Borneo_Record", "No_BLAST_Hits",
                       "Above_Genus_Level", "NUMTs", "Human", "Domestic_Animal")

# Find the exclusion labels recorded in each OTU note.
exclusion_matches <- function(df) {
  # Make one TRUE/FALSE column for each exclusion reason.
  notes <- coalesce(df$Note, "")
  matches <- matrix(
    FALSE,
    nrow = nrow(df),
    ncol = length(filter_categories)
  )
  colnames(matches) <- filter_categories

  # Mark each OTU whose note contains the current reason.
  for (category in filter_categories) {
    pattern <- regex(category, ignore_case = TRUE)
    matches[, category] <- str_detect(notes, pattern)
  }

  matches
}

# Remove excluded OTUs and control sample columns, without altering input files.
filter_retained_otus <- function(df) {
  excluded <- rowSums(exclusion_matches(df)) > 0
  control_cols <- names(df)[str_detect(names(df), "^Control_")]
  df[!excluded, , drop = FALSE] %>% select(-any_of(control_cols))
}

# Derive one Taxon label per OTU: species if available, otherwise Genus_sp.
# Preserve genus-level detections rather than treating them as species.
clean_taxonomy <- function(df) {
  df %>% mutate(across(c(Class, Order, Family, Genus, Species, IUCN),
                       ~ na_if(trimws(as.character(.x)), "")),
                across(c(Class, Order, Family, Genus, Species, IUCN),
                       ~ na_if(.x, "NA")),
                Taxon = case_when(!is.na(Species) ~ Species,
                                  !is.na(Genus) ~ paste0(Genus, "_sp."),
                                  TRUE ~ NA_character_))
}

# Collapse duplicate OTU identifications within each marker. Only taxonomic
# metadata are retained: no indiscriminate summing of numeric metadata.
collapse_by_taxon <- function(df, marker_name) {
  df %>% filter(!is.na(Taxon)) %>% group_by(Taxon) %>%
    summarise(
      across(c(Class, Order, Family, Genus, Species, IUCN), first_available),
              Marker = marker_name,
              N_OTUs = n(),
              .groups = "drop")
}

# 4. PANEL A | READ PROPORTIONS ------------------------------------------------
# Convert read counts and percentages from text to numeric values.
reads_df <- reads_df %>%
  mutate(
    across(
      c(
        total_reads,
        `12S_reads`, `12S_reads_%`,
        `16S_reads`, `16S_reads_%`,
        unassign_reads, `unassign_reads_%`
      ),
      # Convert '-' to missing, then extract the numeric part of each value.
      # NOTE: parse_number() uses locale rules; check separator conventions.
      ~ parse_number(na_if(.x, "-"))
    )
  )

# Sum the total sequencing reads across all samples.
total_reads <- sum(reads_df$total_reads, na.rm = TRUE)

# Sum reads assigned to the 12S marker.
total_12S_reads <- sum(reads_df$`12S_reads`, na.rm = TRUE)

# Sum reads assigned to the 16S marker.
total_16S_reads <- sum(reads_df$`16S_reads`, na.rm = TRUE)

# Sum reads not assigned to either marker.
total_unassigned_reads <- sum(reads_df$unassign_reads, na.rm = TRUE)

# Create a four-row table with read totals and percentages of all reads.
read_summary <- tibble(
  Category = c(
    "Total reads", "12S reads", "16S reads", "Unassigned reads"
  ),
  Reads = c(
    total_reads, total_12S_reads, total_16S_reads, total_unassigned_reads
  ),
  Percentage = c(
    100,
    (total_12S_reads / total_reads) * 100,
    (total_16S_reads / total_reads) * 100,
    (total_unassigned_reads / total_reads) * 100
  )
)

# Prepare a human-readable copy for console display only.
read_summary_display <- read_summary %>%
  mutate(
    # Format read counts for the console.
    Reads = comma(Reads, accuracy = 3),

    # Format percentages to three decimal places for the console.
    Percentage = paste0(number(Percentage, accuracy = 0.001), "%")
  )

# Show the formatted sequencing summary in the R console.
print(read_summary_display)

# Arrange sample IDs from highest to lowest percentage of 12S reads.
# This ordering determines the left-to-right position of samples in Panel A.
sample_order <- reads_df %>%
  arrange(desc(`12S_reads_%`)) %>%
  pull(sample_ID)

# Reshape from wide format (one column per marker) to long format
# (one row per sample-marker combination), as required by ggplot2.
reads_long <- reads_df %>%
  # Keep only the sample identifier and the three percentage columns.
  select(sample_ID, `12S_reads_%`, `16S_reads_%`, `unassign_reads_%`) %>%

  # Gather the three marker columns into Category and Proportion columns.
  pivot_longer(
    cols = -sample_ID,
    names_to = "Category",
    values_to = "Proportion"
  ) %>%
  mutate(
    # Replace original CSV column names with concise legend labels.
    Category = recode(
      Category,
      `12S_reads_%` = "12S",
      `16S_reads_%` = "16S",
      `unassign_reads_%` = "Unassigned"
    ),

    # Fix the stacking and legend order of marker categories.
    Category = factor(Category, levels = c("12S", "16S", "Unassigned")),

    # Preserve the previously calculated left-to-right sample order.
    sample_ID = factor(sample_ID, levels = sample_order)
  )

# Build Panel 2A as a stacked bar chart of marker proportions per sample.
Panel_2A <- ggplot(
  reads_long,
  aes(x = sample_ID, y = Proportion, fill = Category)
) +
  geom_col(position = "fill", na.rm = TRUE) +
  scale_y_continuous(
    labels = percent_format(accuracy = 1),
    breaks = seq(0, 1, 0.25),
    expand = expansion(mult = c(0, 0))
  ) +
  scale_fill_manual(values = marker_colours) +
  labs(x = NULL, y = "Read proportion", fill = NULL) +
  publication_theme +
  theme(
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),
    legend.position = "top",
    legend.direction = "horizontal"
  )

