  filter(Marker == "Combined") %>%
  select(Taxa = Taxon, Species, Genera = Genus, Families = Family,
         Orders = Order, Classes = Class)

# Include all observed vertebrate classes, including those with zero species.
class_summary <- otu_combined %>%
  group_by(Class) %>%
  summarise(Taxa = n_distinct(Taxon),
            Species = n_distinct(Species, na.rm = TRUE),
            Genus_only_taxa = n_distinct(Taxon[is.na(Species)]),
            .groups = "drop") %>%
  arrange(desc(Species), Class)

# Complete list of species-level identifications by vertebrate class.
species_by_class <- otu_combined %>%
  filter(!is.na(Species)) %>%
  select(Class, Order, Family, Genus, Species, Taxon, Marker, IUCN) %>%
  arrange(Class, Species)

# Genus-level records; useful for confirming reptile Lipinia_sp. status.
genus_only_taxa <- otu_combined %>%
  filter(is.na(Species)) %>%
  select(Class, Order, Family, Genus, Taxon, Marker) %>%
  arrange(Class, Taxon)

# 10. IUCN TABLES | COUNTS AND ANIMAL NAMES -----------------------------------
# IUCN status is species-specific; restrict these counts to species-level taxa.
iucn_levels <- c("CR", "EN", "VU", "NT", "LC", "DD", "NE", "EX", "EW", "NA")
iucn_species <- species_by_class %>%
  mutate(IUCN = toupper(trimws(as.character(IUCN))),
         IUCN = if_else(is.na(IUCN) | IUCN == "", "NA", IUCN)) %>%
  arrange(match(IUCN, iucn_levels), Class, Species)

# Count species by conservation status, without percentages.
iucn_summary <- iucn_species %>%
  count(IUCN, name = "Number_of_species") %>%
  arrange(match(IUCN, iucn_levels))

# Each status has its own list; DD is included separately, not 'threatened'.
iucn_species_list <- iucn_species %>%
  select(IUCN, Species, Class, Order, Family, Marker) %>%
  arrange(match(IUCN, iucn_levels), Species)
threatened_species <- iucn_species_list %>% filter(IUCN %in% c("CR", "EN", "VU"))

